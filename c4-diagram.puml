@startuml
!include C4_Context.puml
!include C4_Container.puml

title Sistema de Catalogo com Busca Semantica e RAG

Person(user, "Usuario", "Pesquisa produtos e navega no catalogo")
Person(admin, "Administrador", "Gerencia catalogo e reindexacao")

System_Boundary(s1, "Sistema de Catalogo") {
  System(catalogSystem, "Catalogo com Busca Semantica", "Catalogo de produtos com busca hibrida e IA")
}

System_Ext(storage, "Armazenamento de Imagens", "S3 compativel ou storage local")
System_Ext(groq, "Groq API", "Modelos de chat compativeis com LangChain")

Rel(user, catalogSystem, "Busca produtos, filtra e visualiza detalhes")
Rel(admin, catalogSystem, "Cria, edita e indexa produtos")
Rel(catalogSystem, storage, "Lê e grava imagens")
Rel(catalogSystem, groq, "Gera respostas assistidas quando a camada de RAG for ativada")

LAYOUT_WITH_LEGEND()

newpage
title Sistema de Catalogo com Busca Semantica e RAG - Containers

Person(user2, "Usuario", "Pesquisa produtos e navega no catalogo")
Person(admin2, "Administrador", "Gerencia catalogo e reindexacao")

System_Boundary(s2, "Sistema de Catalogo") {
  Container(web, "Frontend", "Next.js", "Interface publica, SEO, busca e paginas de produto")
  Container(adminWeb, "Admin App", "Next.js", "Painel para gestao do catalogo")
  Container(api, "Catalog API", "NestJS", "CRUD, regras de negocio, busca e orquestracao do catalogo")
  Container(worker, "Ingestion Worker", "NestJS Worker", "Importacao, limpeza, embeddings e reindexacao")
  ContainerDb(db, "PostgreSQL + pgvector", "PostgreSQL", "Produtos, atributos, buscas e vetores")
  Container(storage2, "Object Storage", "S3 compativel", "Imagens e arquivos do catalogo")
  Container(ai, "AI Pipeline", "LangChain + Groq", "RAG, tool calling, structured output e respostas assistidas")
}

Rel(user2, web, "Acessa catalogo e busca")
Rel(admin2, adminWeb, "Gerencia produtos e reindexacao")

Rel(web, api, "Consulta catalogo e busca")
Rel(adminWeb, api, "CRUD e operacoes administrativas")

Rel(api, db, "Lê/escreve dados do catalogo")
Rel(api, storage2, "Lê imagens e assets")
Rel(api, ai, "Solicita recuperacao semantica e respostas assistidas")

Rel(worker, api, "Publica documentos semanticos e embeddings")
Rel(worker, storage2, "Lê imagens e arquivos importados")
Rel(worker, db, "Persiste dados do catalogo e indexacao")

Rel(ai, groq, "Consulta o modelo Groq para geracao assistida")
Rel(ai, db, "Consulta vetores e documentos")

LAYOUT_WITH_LEGEND()
@enduml
