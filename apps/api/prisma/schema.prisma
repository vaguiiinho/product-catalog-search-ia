generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id           String            @id @default(cuid())
  name         String
  description  String
  price        Decimal           @db.Decimal(10, 2)
  categoryId   String?
  category     Category?         @relation(fields: [categoryId], references: [id])
  attributes   ProductAttribute[]
  images       ProductImage[]
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
}

model Category {
  id       String    @id @default(cuid())
  name     String    @unique
  slug     String    @unique
  products Product[]
}

model ProductAttribute {
  id        String   @id @default(cuid())
  productId String
  key       String
  value     String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  url       String
  alt       String
  position  Int      @default(0)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
}

// A escrita e a busca vetorial usam SQL bruto, pois o Prisma ainda nao expoe
// pgvector como tipo nativo. Declarar a tabela impede que `prisma db push`
// a interprete como objeto legado e descarte o indice de ingestao.
model SemanticDocument {
  id           String                   @id
  productId    String                   @unique @map("product_id")
  title        String
  semanticText String                   @map("semantic_text")
  facets       Json                     @default("{}")
  embedding    Unsupported("vector(8)")
  createdAt    DateTime                 @default(now()) @map("created_at")
  updatedAt    DateTime                 @updatedAt @map("updated_at")

  @@map("semantic_documents")
}
