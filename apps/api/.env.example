# Desenvolvimento local: a API usa o PostgreSQL exposto em localhost.
# O docker-compose substitui apenas o host por "postgres" na rede interna.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/product_catalog

# Opcional: sem a chave, o assistente usa a resposta de fallback.
GROQ_API_KEY=

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=troque-por-uma-senha-forte
ADMIN_NAME=Administrador
JWT_SECRET=gere-um-segredo-aleatorio-com-pelo-menos-32-caracteres

# Necessário apenas se o browser acessar a API diretamente no desenvolvimento.
# Deixe vazio no deploy normal: nginx entrega web e /api no mesmo domínio.
CORS_ORIGIN=http://localhost:3000
